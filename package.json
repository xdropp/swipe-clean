{
  "name": "swipe-clean",
  "productName": "Swipe Clean",
  "version": "1.4.0",
  "description": "Free up space on your PC by swiping cards: left removes, right keeps. Games, apps and large folders.",
  "main": "main.js",
  "author": "Gabriel Froes",
  "license": "MIT",
  "homepage": "https://github.com/xdropp/swipe-clean#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xdropp/swipe-clean.git"
  },
  "bugs": {
    "url": "https://github.com/xdropp/swipe-clean/issues"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.gabrielfroes.swipeclean",
    "productName": "Swipe Clean",
    "copyright": "© 2026 Gabriel Froes",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "scanner.js",
      "games.js",
      "system-filter.js",
      "i18n.js",
      "pix.js",
      "doacao.json",
      "vendor/**",
      "scripts/**",
      "renderer/**",
      "package.json"
    ],
    "asarUnpack": [
      "scripts/**",
      "scanner.js",
      "games.js",
      "system-filter.js",
      "i18n.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swipe Clean",
      "installerLanguages": [
        "en_US",
        "pt_BR"
      ],
      "language": "1033",
      "license": "LICENSE.txt",
      "artifactName": "SwipeClean-Setup-${version}.${ext}",
      "uninstallDisplayName": "Swipe Clean",
      "displayLanguageSelector": false
    },
    "portable": {
      "artifactName": "SwipeClean-Portable-${version}.${ext}"
    }
  }
}
